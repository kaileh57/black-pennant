[internationalization]

locale/fallback="en"
pseudolocalization/use_pseudolocalization=false
pseudolocalization/expansion_ratio=0.3
pseudolocalization/fake_bidi=true
pseudolocalization/replace_with_accents=false

[layer_names]

3d_render/layer_1="hulls"
3d_render/layer_2="parts"
3d_render/layer_3="ocean"
3d_render/layer_4="vfx"
3d_render/layer_5="scenery"
3d_render/layer_6="dock_overlays"

[physics]

3d/physics_engine="Dummy"
2d/physics_engine="Dummy"

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
rendering_device/driver.macos="metal"
rendering_device/driver.linuxbsd="vulkan"
rendering_device/fallback_to_vulkan=true
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
limits/time/time_rollover_secs=2048.0
textures/streaming/enabled=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
anti_aliasing/screen_space_roughness_limiter/enabled=true
viewport/hdr_2d=false
