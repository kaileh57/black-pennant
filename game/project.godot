; Engine configuration file. Contract-owned: change only through the orchestrator.
; Sections are sorted. DESIGN.md pins: renderer keys (L1268), stretch (L1732), dummy physics (L1094),
; pseudolocalization values (L1740), time rollover (L1891), Tab and Space off the ui_* actions (L1738).

config_version=5

[application]

config/name="Black Pennant"
config/version="0.1.0"
run/main_scene="res://boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="BlackPennant"
run/low_processor_mode=false
boot_splash/show_image=false

[audio]

buses/default_bus_layout="res://audio/bus_layout.tres"

[autoload]

I18n="*res://autoload/i18n.gd"
App="*res://autoload/app.gd"
Settings="*res://autoload/settings.gd"
Quality="*res://autoload/quality.gd"
Tx="*res://autoload/tx.gd"
Content="*res://autoload/content.gd"
Session="*res://autoload/session.gd"
Orders="*res://autoload/orders.gd"
Hud="*res://autoload/hud.gd"
Editor="*res://autoload/editor.gd"
Campaign="*res://autoload/campaign.gd"
Lobby="*res://autoload/lobby.gd"
Tutorial="*res://autoload/tutorial.gd"
AudioFeed="*res://autoload/audio_feed.gd"
Bench="*res://autoload/bench.gd"
Ui="*res://autoload/ui.gd"
Screens="*res://autoload/screens.gd"
Sound="*res://audio/sound.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/dpi/allow_hidpi=true

[gui]

theme/custom="res://ui/theme/project_theme.tres"
fonts/dynamic_fonts/use_oversampling=true
common/snap_controls_to_pixels=true

