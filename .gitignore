# Rust
/target/
**/*.rs.bk

# Godot
.godot/
*.import.tmp
*.uid.tmp
/game/export/
export_presets.cfg.local
# The I18n autoload reads the raw CSVs; their importer is `keep`, so a compiled translation is a stray.
/game/i18n/*.translation

# Generated by cargo xtask gen (regenerate, never commit by hand)
/game/shaders/gen/
/game/art/gen/
/game/audio/gen/

# Steamworks SDK is fetched at build time and never committed
/steamworks_sdk*/
**/steam_api*.dll
**/libsteam_api.dylib


# OS and editors
.DS_Store
*.swp
.vscode/
.idea/

# Local captures and benchmark output
/captures/
/bench-results/

# Merge queue scratch
.land-build.log
