            (id: "drones", text: "tutorial.drones", lesson: 3, done: Some("tutorial.done.drones"), complete: Any([All([PlayerGunsFired, Any([HelmInput, After(seconds: 20)]), Any([EnemyDestroyed, Dwell(seconds: 30)])]), After(seconds: 300)]), marks_first_fight: true),
            (id: "done", text: "tutorial.done_short", lesson: 0, complete: Continue),
        ],
    ),
]
