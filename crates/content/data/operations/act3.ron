    // =========================================================================================================
    // Story operations
    // =========================================================================================================
    // 1. The Saltby lighter: the bulk carrier that brought the Hollin yard its new heavy gun mounts lies at Saltby,
    // waiting to unload. Cut her out and the mounts' drawings come with her: tier 5 opens. Commitment: garrison
    // 1,587 t (3) + gun task group 4,112 t (5) = 5,699 t, 8 hulls (the lighter does not count).
    (
        id: "op.act3.story.saltby", kind: Story, act: Act3,
        name: "op.act3.story.saltby.name", briefing: "op.act3.story.saltby.briefing",
        node: Some("harbour.saltby"),
        objective: CutOut(tag: "prize", exit: "exit"),
        tags: [DraftLimit(max_m: 4.0), Requires(BoardingKit), RcsLimit(max_m2: 280.0)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoKills, reward: Intel(1)), (kind: NoHullDamage, reward: Intel(1))],
        force: [
            (fleet: "fleet.act3.convoy.lighter", marker: "berth", tag: "prize"),
            (fleet: "fleet.act3.garrison", marker: "berth", tag: "harbour"),
            (fleet: "fleet.act3.tg.gun", marker: "enemy", tag: "task_group"),
        ],
        complications: [None, WeatherTurns(to: FogBank, at_s: 300)],
        approach_m: 11000.0,
        actions: [BoardAndCapture],
        recommended_emcon: Some(Silent),
    ),
    // 2. The Greywater channel: the boats from the Hollin yard reach open water through Greywater. Mine it under
    // their noses, with a pack on patrol in the channel. The Actuary arrives. Needs Saltby or Supply under 70.
    // Commitment: heavy patrol 1,873 t (3) + anti-submarine task group 3,758 t (5) = 5,631 t, 8 hulls, plus the pack
    // and the Actuary.
    (
        id: "op.act3.story.greywater", kind: Story, act: Act3,
        name: "op.act3.story.greywater.name", briefing: "op.act3.story.greywater.briefing",
        unlock: Any([Completed(["op.act3.story.saltby"]), SupplyBelow(region: "region.hollin", value: 70.0)]),
        node: Some("sea.greywater"),
        objective: LayMines(marker: "lane", count: 10),
        tags: [Requires(MineRail), Range(min_km: 350.0), RcsLimit(max_m2: 280.0)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoKills, reward: Intel(1)), (kind: NoHullDamage, reward: Intel(1))],
        force: [
            (fleet: "fleet.act3.patrol.heavy", marker: "lane", tag: "patrol"),
            (fleet: "fleet.act3.tg.asw", marker: "enemy", tag: "task_group"),
            (fleet: "fleet.act3.sub.pack", marker: "objective", tag: "submarine"),
        ],
        complications: [AceArrives("ace.actuary")],
        approach_m: 13000.0,
        actions: [LayMines],
        declared_hostile: ["class.dividend", "class.ace_contingency"],
        recommended_emcon: Some(Silent),
    ),
    // 3. The Vell engineers: the yard engineers who know when Foreclosure sails come down to the shore by Vell
    // depot. Take them off by boat. Needs Saltby, then the Greywater channel or Alert 2 in the region. Commitment:
    // patrol 757 t (2) + gun task group 4,112 t (5) = 4,869 t, 7 hulls.
    (
        id: "op.act3.story.vell", kind: Story, act: Act3,
        name: "op.act3.story.vell.name", briefing: "op.act3.story.vell.briefing",
        unlock: All([Completed(["op.act3.story.saltby"]), Any([Completed(["op.act3.story.greywater"]), AlertAtLeast(region: "region.hollin", value: 2)])]),
        node: Some("depot.vell"),
        objective: Extract(marker: "landing", passengers: 6),
        tags: [Passengers(count: 6, allowed_losses: 1), Requires(RhibDavit), RcsLimit(max_m2: 260.0)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoKills, reward: Intel(1)), (kind: NoHullDamage, reward: Intel(1))],
        force: [
            (fleet: "fleet.act3.patrol", marker: "enemy_2", tag: "patrol"),
            (fleet: "fleet.act3.tg.gun", marker: "enemy", tag: "task_group"),
        ],
        complications: [None, WeatherTurns(to: FogBank, at_s: 300), AirPatrol],
        approach_m: 12000.0,
        actions: [InsertOrExtract, CarryPassengers],
        recommended_emcon: Some(Silent),
    ),
    // 4. The Strand bunkers: the fleet tankers that will fuel Foreclosure for her first patrol cross the Spindle under
    // a destroyer escort, with a boat ahead of them. The Liquidator arrives. Needs the Greywater channel, then the
    // Vell engineers or Supply under 40. Commitment: convoy escort 3,661 t (5) + Foreclosure 2,038 t when she
    // arrives = 5,699 t, 6 hulls, plus the boat.
    (
        id: "op.act3.story.strand", kind: Story, act: Act3,
        name: "op.act3.story.strand.name", briefing: "op.act3.story.strand.briefing",
        unlock: All([Completed(["op.act3.story.greywater"]), Any([Completed(["op.act3.story.vell"]), SupplyBelow(region: "region.hollin", value: 40.0)])]),
        node: Some("sea.spindle"),
        objective: DestroyGroup(tag: "convoy", fraction: 0.75),
        tags: [MinSpeed(kn: 26.0), Range(min_km: 400.0)],
        ghosts: [(kind: UnderTime(seconds: 1500), reward: Intel(1)), (kind: NoHullDamage, reward: Intel(1)), (kind: NoRadarEmissions, reward: Intel(1))],
        force: [
            (fleet: "fleet.act3.convoy.tankers", marker: "convoy_entry", tag: "convoy"),
            (fleet: "fleet.act3.escort.convoy", marker: "convoy_entry", tag: "escort"),
            (fleet: "fleet.act3.sub", marker: "convoy_exit", tag: "submarine"),
        ],
        complications: [AceArrives("ace.liquidator")],
        approach_m: 16000.0,
        declared_hostile: ["class.dividend", "class.collateral", "class.ace_foreclosure"],
        recommended_emcon: Some(Silent),
    ),

    // =========================================================================================================
    // Ace duels: the ace's flagship sails alone in its own group (tag "ace"); its consorts sail apart.
    // =========================================================================================================
    // Commitment: Contingency 1,016 t (1) + anti-submarine task group 3,758 t (5) = 4,774 t, 6 hulls, plus a pack of
    // boats working with her.
    (
        id: "op.act3.duel.actuary", kind: AceDuel("ace.actuary"), act: Act3,
        name: "op.act3.duel.actuary.name", briefing: "op.act3.duel.actuary.briefing",
        unlock: Completed(["op.act3.story.greywater"]),
        objective: DestroyGroup(tag: "ace", fraction: 1.0),
        tags: [Range(min_km: 400.0), RcsLimit(max_m2: 260.0)],
        ghosts: [(kind: CaptureTheAce, reward: Intel(3)), (kind: NeverDetected, reward: Intel(2))],
        force: [
            (fleet: "fleet.act3.ace.contingency", marker: "enemy", tag: "ace"),
            (fleet: "fleet.act3.tg.asw", marker: "enemy_2", tag: "task_group"),
            (fleet: "fleet.act3.sub.pack", marker: "objective", tag: "submarine"),
        ],
        complications: [None, WeatherTurns(to: Haze, at_s: 600), AirPatrol],
        approach_m: 16000.0,
        declared_hostile: ["class.ace_contingency"],
    ),
    // Commitment: Foreclosure 2,038 t (1) + gun task group 4,112 t (5) = 6,150 t, 6 hulls. The act's "defaults fail,
    // sliders pass" operation; see the header for its reference setup. It waits on Saltby too, so the 155 mm turret
    // its capture ghost pays out is in a tier already open.
    (
        id: "op.act3.duel.liquidator", kind: AceDuel("ace.liquidator"), act: Act3,
        name: "op.act3.duel.liquidator.name", briefing: "op.act3.duel.liquidator.briefing",
        unlock: Completed(["op.act3.story.saltby", "op.act3.story.strand"]),
        objective: DestroyGroup(tag: "ace", fraction: 1.0),
        tags: [MinSpeed(kn: 26.0), Range(min_km: 400.0)],
        ghosts: [(kind: CaptureTheAce, reward: Intel(3)), (kind: NoHullDamage, reward: Intel(2))],
        force: [
            (fleet: "fleet.act3.ace.foreclosure", marker: "enemy", tag: "ace", emcon: Some(Silent)),
            (fleet: "fleet.act3.tg.gun", marker: "enemy_2", tag: "task_group"),
        ],
        complications: [WeatherTurns(to: Rain, at_s: 300)],
        approach_m: 16000.0,
        declared_hostile: ["class.ace_foreclosure"],
        reference_setup: Some("reference/act3/duel_liquidator.bp.ron"),
    ),

    // =========================================================================================================
    // Capstone: the Hollin slipways. Open once the four story operations are done (the generator checks the act's
    // list).
    // =========================================================================================================
    // Commitment: garrison 1,587 t (3) + heavy task group 5,008 t (5) + strike task group at 600 s 3,953 t (5)
    // = 10,548 t, 13 hulls, plus a coastal boat off the yard, a four-aircraft raid at 300 s and the Liquidator if
    // still at sea.
    (
        id: "op.act3.capstone", kind: Capstone, act: Act3,
        name: "op.act3.capstone.name", briefing: "op.act3.capstone.briefing",
