    // Commitment: patrol 2 x 24 + 54 = 102 t (3) + gun task group 649 t (5) = 751 t, 8 hulls.
    (
        id: "op.act1.agent_extraction", kind: Template(AgentExtraction), act: Act1,
        name: "op.act1.agent_extraction.name", briefing: "op.act1.agent_extraction.briefing",
        unlock: Completed(["op.act1.story.blind_crane"]),
