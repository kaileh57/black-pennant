// Vec<OperationDef>: Act 1 operations (DESIGN.md L778-807, L85-102). Unit `data-operations-act1`. Licensed CC BY 4.0.
//
// The eleven templates, four story operations, two ace duels, the capstone and the tutorial sortie. Every
// operation commits at least 5 hostile combat hulls and 600 t on its force's worst draw (minimum count of the
// lightest class per slot; convoys, prizes, moored hulls and defectors do not count), so the generator never
// needs a reinforcement wave in Act 1. Two exceptions: hunter-group survival, whose threat is the theatre's hunter
// group records (standalone, the generator's waves make up the multiples), and the tutorial sortie's single
// patrol boat, a first lesson rather than a campaign operation. The numbers per operation are in the comments.
//
// Templates name map markers from the shared vocabulary every theatre node map carries (spawn, enemy, enemy_2,
// objective, lane, exit, convoy_entry, convoy_exit, survivors, berth, landing, depot, radar), so they play on
// any node the generator places them at. Story operations, duels and the capstone use their node's map.
//
// Tiers: Blind Crane Head opens tier 2 and Kessel toll tier 3 (acts.ron). Templates and story operations that
// need a tier 2 part (RHIB davit, passenger berths, mine rail, camera mast) wait for the first; those that need
// the tier 3 boarding kit wait for the second. Every story unlock has a theatre-condition path and a progress
// path, so the act can never stall on Supply or Alert alone.
//
// Constraint tag limits (draft, cross-section) are first values for the Fit Check gates to calibrate: the
// cross-section scale is not fixed until sim-core's projected areas exist. Approach distances are the authored
// values the sortie-length fallback scales within 50% to 150% (L85-90).
[
    // =========================================================================================================
    // Templates
    // =========================================================================================================
    // Commitment: convoy escort 2 x 252 + 3 x 54 = 666 t, 5 hulls.
    (
        id: "op.act1.convoy_raid", kind: Template(ConvoyRaid), act: Act1,
        name: "op.act1.convoy_raid.name", briefing: "op.act1.convoy_raid.briefing",
        objective: DestroyGroup(tag: "convoy", fraction: 0.6),
        tags: [MinSpeed(kn: 26.0), Range(min_km: 200.0)],
        ghosts: [(kind: NoRadarEmissions, reward: Intel(1)), (kind: UnderTime(seconds: 1500), reward: Intel(1))],
        force: [
            (fleet: "fleet.act1.convoy", marker: "convoy_entry", tag: "convoy"),
            (fleet: "fleet.act1.escort.convoy", marker: "convoy_entry", tag: "escort"),
        ],
        complications: [None, DecoyConvoy, WeatherTurns(to: Rain, at_s: 900), Reinforcements(fleet: "fleet.act1.patrol", at_s: 1200), CivilianTraffic],
        approach_m: 14000.0,
        declared_hostile: ["class.patrol_corvette", "class.escort_corvette"],
        recommended_emcon: Some(Silent),
    ),
    // Commitment: garrison 2 x 24 + 90 = 138 t (3 hulls) + gun task group 649 t (5) = 787 t, 8 hulls.
    (
        id: "op.act1.depot_strike", kind: Template(DepotStrike), act: Act1,
        name: "op.act1.depot_strike.name", briefing: "op.act1.depot_strike.briefing",
        objective: DestroySite(marker: "depot"),
        tags: [Range(min_km: 250.0), DraftLimit(max_m: 3.0)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoHullDamage, reward: Intel(1))],
        force: [
            (fleet: "fleet.act1.garrison", marker: "depot", tag: "garrison"),
            (fleet: "fleet.act1.tg.gun", marker: "enemy", tag: "task_group"),
        ],
        complications: [None, WeatherTurns(to: FogBank, at_s: 600), Minefield, Reinforcements(fleet: "fleet.act1.patrol.heavy", at_s: 900)],
        approach_m: 12000.0,
    ),
    // Commitment: garrison 138 t (3) + screen task group 767 t (5) = 905 t, 8 hulls.
    (
        id: "op.act1.radar_decapitation", kind: Template(RadarDecapitation), act: Act1,
        name: "op.act1.radar_decapitation.name", briefing: "op.act1.radar_decapitation.briefing",
        objective: DestroySite(marker: "radar"),
        tags: [RcsLimit(max_m2: 80.0), Range(min_km: 200.0)],
        ghosts: [(kind: NoRadarEmissions, reward: Intel(1)), (kind: NeverDetected, reward: Intel(2))],
        force: [
            (fleet: "fleet.act1.garrison", marker: "radar", tag: "garrison"),
            (fleet: "fleet.act1.tg.screen", marker: "enemy", tag: "task_group"),
        ],
        complications: [None, WeatherTurns(to: Haze, at_s: 600), CivilianTraffic, Reinforcements(fleet: "fleet.act1.patrol", at_s: 900)],
        approach_m: 12000.0,
