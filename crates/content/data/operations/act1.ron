    // =========================================================================================================
    // Story operations
    // =========================================================================================================
    // 1. Blind Crane Head: the radar that watches the western approaches. Opens tier 2.
    // Commitment: garrison 138 t (3) + gun task group 649 t (5) = 787 t, 8 hulls.
    (
        id: "op.act1.story.blind_crane", kind: Story, act: Act1,
        name: "op.act1.story.blind_crane.name", briefing: "op.act1.story.blind_crane.briefing",
        node: Some("radar.crane"),
        objective: DestroySite(marker: "radar"),
        tags: [Range(min_km: 150.0), DraftLimit(max_m: 3.0)],
        ghosts: [(kind: NoRadarEmissions, reward: Intel(1)), (kind: NeverDetected, reward: Intel(2)), (kind: NoHullDamage, reward: Blueprint("decoy.chaff"))],
        force: [
            (fleet: "fleet.act1.garrison", marker: "radar", tag: "garrison"),
            (fleet: "fleet.act1.tg.gun", marker: "enemy", tag: "task_group"),
        ],
        complications: [None],
        approach_m: 11000.0,
        recommended_emcon: Some(Silent),
    ),
    // 2. Kessel toll: the convoy run through the region's chokepoint. The Auditor arrives. Opens tier 3.
    // Commitment: convoy escort 666 t (5) + the Auditor's Arrears 122 t when she arrives = 788 t, 6 hulls.
    (
        id: "op.act1.story.kessel_toll", kind: Story, act: Act1,
        name: "op.act1.story.kessel_toll.name", briefing: "op.act1.story.kessel_toll.briefing",
        unlock: Any([Completed(["op.act1.story.blind_crane"]), SupplyBelow(region: "region.gannet", value: 70.0)]),
        node: Some("sea.kessel"),
        objective: DestroyGroup(tag: "convoy", fraction: 0.75),
        tags: [MinSpeed(kn: 26.0), Range(min_km: 200.0)],
        ghosts: [(kind: UnderTime(seconds: 1500), reward: Intel(1)), (kind: NoHullDamage, reward: Intel(1)), (kind: NoRadarEmissions, reward: Blueprint("radar.lpi"))],
        force: [
            (fleet: "fleet.act1.convoy", marker: "convoy_entry", tag: "convoy"),
            (fleet: "fleet.act1.escort.convoy", marker: "convoy_entry", tag: "escort"),
        ],
        complications: [AceArrives("ace.auditor")],
        approach_m: 14000.0,
        declared_hostile: ["class.patrol_corvette", "class.escort_corvette", "class.ace_arrears"],
        recommended_emcon: Some(Silent),
    ),
    // 3. Quiet hand: bring out the Mareby harbour pilot who charts the Combine's swept channels.
    // Needs tier 2 (RHIB, passenger berths): Blind Crane Head first, then Kessel toll or Alert 2 in the region.
    // Commitment: garrison 138 t (3) + screen task group 767 t (5) = 905 t, 8 hulls.
    (
        id: "op.act1.story.quiet_hand", kind: Story, act: Act1,
        name: "op.act1.story.quiet_hand.name", briefing: "op.act1.story.quiet_hand.briefing",
        unlock: All([Completed(["op.act1.story.blind_crane"]), Any([Completed(["op.act1.story.kessel_toll"]), AlertAtLeast(region: "region.gannet", value: 2)])]),
        node: Some("harbour.mareby"),
        objective: Extract(marker: "landing", passengers: 3),
        tags: [Passengers(count: 3, allowed_losses: 0), Requires(RhibDavit), RcsLimit(max_m2: 80.0)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoKills, reward: Intel(1)), (kind: NoRadarEmissions, reward: Intel(1))],
        force: [
            (fleet: "fleet.act1.garrison", marker: "berth", tag: "harbour"),
            (fleet: "fleet.act1.tg.screen", marker: "enemy", tag: "task_group"),
        ],
        complications: [None, WeatherTurns(to: FogBank, at_s: 300)],
        approach_m: 11000.0,
        actions: [InsertOrExtract, CarryPassengers],
        recommended_emcon: Some(Silent),
    ),
    // 4. The Bursar's berth: cut the Combine's supply tender out of Port Ollan. The Bailiff arrives.
    // Needs tier 3 (boarding kit): Kessel toll first, then Quiet hand or Supply under 40.
    // Commitment: garrison 138 t (3) + heavy task group 1,044 t (5) = 1,182 t, 8 hulls, plus the Bailiff.
    (
        id: "op.act1.story.bursars_berth", kind: Story, act: Act1,
        name: "op.act1.story.bursars_berth.name", briefing: "op.act1.story.bursars_berth.briefing",
        unlock: All([Completed(["op.act1.story.kessel_toll"]), Any([Completed(["op.act1.story.quiet_hand"]), SupplyBelow(region: "region.gannet", value: 40.0)])]),
        node: Some("base.ollan"),
        objective: CutOut(tag: "prize", exit: "exit"),
        tags: [DraftLimit(max_m: 2.5), Requires(BoardingKit), Range(min_km: 150.0)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoKills, reward: Intel(1)), (kind: NoHullDamage, reward: Blueprint("radar.fire_control"))],
        force: [
            (fleet: "fleet.act1.convoy.moored", marker: "berth", tag: "prize"),
            (fleet: "fleet.act1.garrison", marker: "berth", tag: "harbour"),
            (fleet: "fleet.act1.tg.heavy", marker: "enemy", tag: "task_group"),
        ],
        complications: [AceArrives("ace.bailiff")],
        approach_m: 10000.0,
        actions: [BoardAndCapture],
        declared_hostile: ["class.frigate", "class.ace_covenant"],
        recommended_emcon: Some(Silent),
    ),

