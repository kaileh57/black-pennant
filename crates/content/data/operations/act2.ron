    // Commitment: gun task group 1,805 t (5) + patrol 309 t (2) = 2,114 t, 7 hulls.
    (
        id: "op.act2.feint", kind: Template(Feint), act: Act2,
        name: "op.act2.feint.name", briefing: "op.act2.feint.briefing",
        objective: Feint(hold_s: 300),
        tags: [MinSpeed(kn: 28.0), Range(min_km: 300.0)],
        ghosts: [(kind: NoHullDamage, reward: Intel(1)), (kind: NoKills, reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.tg.gun", marker: "enemy", tag: "task_group"),
            (fleet: "fleet.act2.patrol", marker: "enemy_2", tag: "patrol"),
        ],
        complications: [None, WeatherTurns(to: Haze, at_s: 300), AirPatrol, Reinforcements(fleet: "fleet.act2.patrol.heavy", at_s: 600)],
        approach_m: 12000.0,
    ),
    // Commitment: garrison 597 t (3) + screen task group 1,767 t (5) = 2,364 t, 8 hulls.
    (
        id: "op.act2.photo_reconnaissance", kind: Template(PhotoReconnaissance), act: Act2,
        name: "op.act2.photo_reconnaissance.name", briefing: "op.act2.photo_reconnaissance.briefing",
        objective: Photograph(tag: "target", count: 3),
        tags: [Requires(CameraMast), RcsLimit(max_m2: 160.0)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoRadarEmissions, reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.garrison", marker: "objective", tag: "target"),
            (fleet: "fleet.act2.tg.screen", marker: "enemy", tag: "task_group"),
        ],
        complications: [None, WeatherTurns(to: Haze, at_s: 600), CivilianTraffic, AirPatrol],
        approach_m: 15000.0,
        actions: [Photograph],
        recommended_emcon: Some(Silent),
    ),
    // Commitment in the campaign: the hunter group's five top-tier hulls plus this screen. Standalone (no theatre
    // state) the screen alone is 309 t, and the generator's reinforcement waves make up the multiples.
    (
        id: "op.act2.hunter_survival", kind: Template(HunterGroupSurvival), act: Act2,
        name: "op.act2.hunter_survival.name", briefing: "op.act2.hunter_survival.briefing",
        objective: Survive(seconds: 900, exit: "exit"),
        tags: [MinSpeed(kn: 28.0), Range(min_km: 300.0)],
        ghosts: [(kind: NoHullDamage, reward: Intel(1)), (kind: NoKills, reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.patrol", marker: "enemy_2", tag: "screen"),
        ],
        complications: [None, WeatherTurns(to: Rain, at_s: 600), WeatherTurns(to: FogBank, at_s: 300), AirPatrol],
        approach_m: 9000.0,
    ),
    // Commitment: garrison 597 t (3) + gun task group 1,805 t (5) = 2,402 t, 8 hulls (the moored prize does not count).
    (
        id: "op.act2.cutting_out", kind: Template(CuttingOut), act: Act2,
