// Vec<OperationDef>: Act 2 operations, Corran Sound (DESIGN.md L778-807, L85-102, L317-318, L866-875). Unit
// `data-act2`. Licensed CC BY 4.0.
//
// The eleven templates, four story operations, two ace duels and the capstone. Act 2 commits at least 5 hostile
// combat hulls and 1,600 t per player (4 x the 400 t cap), and every operation meets that on its force's worst
// draw (minimum count of the lightest class per slot; convoys, prizes, moored hulls, the defector and aircraft do
// not count), so a solo sortie never needs a reinforcement wave. The numbers per operation are in the comments.
// The generator scopes templates to the latest act that has any, so these eleven replace Act 1's from the Act 2
// start: they name only Act 2 fleets and unlock at once, because tier 4 (and every special-operations part) is
// open from the first day of the act.
//
// Act 2 brings the Combine's strike aircraft. Air patrols come as a complication on most templates and at Alert 3;
// the story operations and the capstone bring their own raids. No operation carries more than six aircraft
// (minimum swarm, L1447).
//
// Templates name map markers from the shared vocabulary every theatre node map carries (spawn, enemy, enemy_2,
// objective, lane, exit, convoy_entry, convoy_exit, survivors, berth, landing, depot, radar). Story operations and
// the capstone take place at their nodes in Corran Sound; the duels where the ace's ship lies.
//
// Constraint tags are set against the 40 m missile corvette starter as the editor's gauges and sim-core's
// projected areas measure it at its design draft: it floats at about 2.2 m, makes about 32 kn, runs about
// 1,500 km at cruise and shows about 233 m^2 of radar cross-section on its worst aspect. Draft limits of 3.0 to
// 3.5 m keep deep 400 t designs out of shallow water and pass the starter as built. Cross-section limits of 150
// to 180 m^2 fail the stock starter on purpose, because a stealth insertion wants a specialised ship (L780): the
// starter rebuilt with composite topsides (about 107 m^2) passes them all, as does the Act 1 insertion craft
// (about 50 m^2). Speed and range minimums pass the starter. crates/sim-systems/tests/briefing_tags_act2.rs
// checks these numbers. Approach distances are the authored values the sortie-length fallback scales within 50%
// to 150% (L85-90).
//
// Ghost conditions pay Intel. Tier 4 and every special-operations part are open from the first day of the act,
// and the dry dock offers every part of an open tier, so a blueprint reward would unlock nothing in Act 2 (L815:
// blueprints unlock parts within tiers already open). Capturing an ace pays 3 Intel, the price of finding one.
//
// The Underwriter duel is the act's "defaults fail, sliders pass" operation (L318): her four-diesel missile ship
// runs silent and closes at speed, and stock officers on the Cautious preset hold fire for an
// identification they never get. Its reference setup is a committed blueprint, the 40 m starter with an L0 to L2
// setup (Aggressive preset, burst radar at 30 km, two rules that go active and engage when a hostile surface
// contact closes), which the winnability harness applies over each player hull's stored settings.
[
    // =========================================================================================================
    // Templates
    // =========================================================================================================
    // Commitment: convoy escort 639 + 348 + 3 x 283 = 1,836 t, 5 hulls.
    (
        id: "op.act2.convoy_raid", kind: Template(ConvoyRaid), act: Act2,
        name: "op.act2.convoy_raid.name", briefing: "op.act2.convoy_raid.briefing",
        objective: DestroyGroup(tag: "convoy", fraction: 0.6),
        tags: [MinSpeed(kn: 28.0), Range(min_km: 300.0)],
        ghosts: [(kind: NoRadarEmissions, reward: Intel(1)), (kind: UnderTime(seconds: 1500), reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.convoy", marker: "convoy_entry", tag: "convoy"),
            (fleet: "fleet.act2.escort.convoy", marker: "convoy_entry", tag: "escort"),
        ],
        complications: [None, DecoyConvoy, AirPatrol, WeatherTurns(to: Rain, at_s: 900), Reinforcements(fleet: "fleet.act2.patrol", at_s: 1200), CivilianTraffic],
        approach_m: 16000.0,
        declared_hostile: ["class.bond", "class.premium"],
        recommended_emcon: Some(Silent),
    ),
    // Commitment: garrison 2 x 252 + 93 = 597 t (3 hulls) + gun task group 1,805 t (5) = 2,402 t, 8 hulls.
    (
        id: "op.act2.depot_strike", kind: Template(DepotStrike), act: Act2,
        name: "op.act2.depot_strike.name", briefing: "op.act2.depot_strike.briefing",
        objective: DestroySite(marker: "depot"),
        tags: [Range(min_km: 350.0), DraftLimit(max_m: 3.5)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoHullDamage, reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.garrison", marker: "depot", tag: "garrison"),
            (fleet: "fleet.act2.tg.gun", marker: "enemy", tag: "task_group"),
        ],
        complications: [None, AirPatrol, WeatherTurns(to: FogBank, at_s: 600), Minefield, Reinforcements(fleet: "fleet.act2.patrol.heavy", at_s: 900)],
        approach_m: 14000.0,
    ),
    // Commitment: garrison 597 t (3) + screen task group 1,767 t (5) = 2,364 t, 8 hulls.
    (
        id: "op.act2.radar_decapitation", kind: Template(RadarDecapitation), act: Act2,
        name: "op.act2.radar_decapitation.name", briefing: "op.act2.radar_decapitation.briefing",
        objective: DestroySite(marker: "radar"),
        tags: [RcsLimit(max_m2: 150.0), Range(min_km: 300.0)],
        ghosts: [(kind: NoRadarEmissions, reward: Intel(1)), (kind: NeverDetected, reward: Intel(2))],
        force: [
            (fleet: "fleet.act2.garrison", marker: "radar", tag: "garrison"),
            (fleet: "fleet.act2.tg.screen", marker: "enemy", tag: "task_group"),
        ],
        complications: [None, AirPatrol, WeatherTurns(to: Haze, at_s: 600), CivilianTraffic, Reinforcements(fleet: "fleet.act2.patrol", at_s: 900)],
        approach_m: 14000.0,
        actions: [InsertOrExtract],
        recommended_emcon: Some(Silent),
    ),
    // Commitment: patrol 216 + 93 = 309 t (2) + gun task group 1,805 t (5) = 2,114 t, 7 hulls.
    (
        id: "op.act2.agent_extraction", kind: Template(AgentExtraction), act: Act2,
        name: "op.act2.agent_extraction.name", briefing: "op.act2.agent_extraction.briefing",
        objective: Extract(marker: "landing", passengers: 3),
        tags: [Passengers(count: 3, allowed_losses: 0), Requires(RhibDavit), RcsLimit(max_m2: 180.0)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoKills, reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.patrol", marker: "enemy_2", tag: "patrol"),
            (fleet: "fleet.act2.tg.gun", marker: "enemy", tag: "task_group"),
        ],
        complications: [None, WeatherTurns(to: FogBank, at_s: 300), CivilianTraffic, AirPatrol],
        approach_m: 12000.0,
        actions: [InsertOrExtract, CarryPassengers],
        recommended_emcon: Some(Silent),
    ),
    // Commitment: heavy patrol 639 + 2 x 283 = 1,205 t (3) + strike task group 2,017 t (5) = 3,222 t, 8 hulls.
    (
        id: "op.act2.minelaying", kind: Template(Minelaying), act: Act2,
        name: "op.act2.minelaying.name", briefing: "op.act2.minelaying.briefing",
        objective: LayMines(marker: "lane", count: 8),
        tags: [Requires(MineRail), Range(min_km: 250.0)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoKills, reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.patrol.heavy", marker: "lane", tag: "patrol"),
            (fleet: "fleet.act2.tg.strike", marker: "enemy", tag: "task_group"),
        ],
        complications: [None, WeatherTurns(to: Rain, at_s: 600), DecoyConvoy, AirPatrol],
        approach_m: 14000.0,
        actions: [LayMines],
        recommended_emcon: Some(Silent),
    ),
    // Commitment: convoy escort 1,836 t, 5 hulls (the prize hulls do not count).
    (
        id: "op.act2.prize_capture", kind: Template(PrizeCapture), act: Act2,
        name: "op.act2.prize_capture.name", briefing: "op.act2.prize_capture.briefing",
        objective: Capture(tag: "prize"),
        tags: [Requires(BoardingKit), Range(min_km: 250.0)],
        ghosts: [(kind: NoHullDamage, reward: Intel(1)), (kind: UnderTime(seconds: 1800), reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.convoy.prize", marker: "convoy_entry", tag: "prize"),
            (fleet: "fleet.act2.escort.convoy", marker: "convoy_entry", tag: "escort"),
        ],
        complications: [None, DecoyConvoy, AirPatrol, WeatherTurns(to: Overcast, at_s: 600)],
        approach_m: 14000.0,
