    // =========================================================================================================
    // Story operations
    // =========================================================================================================
    // 1. Deaf ear: the listening station on Ness Point that vectors the Combine's strike aircraft onto LANTERN.
    // Its own air cover arrives 10 minutes in. Commitment: garrison 597 t (3) + screen task group 1,767 t (5) = 2,364 t,
    // 8 hulls, plus two strike aircraft.
    (
        id: "op.act2.story.ness", kind: Story, act: Act2,
        name: "op.act2.story.ness.name", briefing: "op.act2.story.ness.briefing",
        node: Some("esm.ness"),
        objective: DestroySite(marker: "radar"),
        tags: [Range(min_km: 300.0), RcsLimit(max_m2: 150.0)],
        ghosts: [(kind: NoRadarEmissions, reward: Intel(1)), (kind: NeverDetected, reward: Intel(2)), (kind: NoHullDamage, reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.garrison", marker: "radar", tag: "garrison"),
            (fleet: "fleet.act2.tg.screen", marker: "enemy", tag: "task_group"),
            (fleet: "fleet.act2.air", marker: "enemy_2", tag: "air", arrives_s: 600),
        ],
        complications: [None, WeatherTurns(to: Overcast, at_s: 600)],
        approach_m: 14000.0,
        recommended_emcon: Some(Silent),
    ),
    // 2. The Amble fuel run: the oilers that fill Amble depot cross Corran water under a frigate escort. The
    // Underwriter arrives. Commitment: convoy escort 1,836 t (5) + Indemnity 246 t when she arrives = 2,082 t,
    // 6 hulls.
    (
        id: "op.act2.story.amble", kind: Story, act: Act2,
        name: "op.act2.story.amble.name", briefing: "op.act2.story.amble.briefing",
        unlock: Any([Completed(["op.act2.story.ness"]), SupplyBelow(region: "region.corran", value: 70.0)]),
        node: Some("sea.corran"),
        objective: DestroyGroup(tag: "convoy", fraction: 0.75),
        tags: [MinSpeed(kn: 28.0), Range(min_km: 300.0)],
        ghosts: [(kind: UnderTime(seconds: 1500), reward: Intel(1)), (kind: NoHullDamage, reward: Intel(1)), (kind: NoRadarEmissions, reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.convoy.oilers", marker: "convoy_entry", tag: "convoy"),
            (fleet: "fleet.act2.escort.convoy", marker: "convoy_entry", tag: "escort"),
        ],
        complications: [AceArrives("ace.underwriter")],
        approach_m: 16000.0,
        declared_hostile: ["class.bond", "class.premium", "class.ace_indemnity"],
        recommended_emcon: Some(Silent),
    ),
    // 3. The Kittering codes: an aviso's crew defects from Kittering harbour with the Combine's air-raid codes and
    // must reach the exit before the pursuit. Needs Deaf ear, then the Amble run or Alert 2 in the region.
    // Commitment: gun task group 1,805 t (5) + patrol 309 t (2) = 2,114 t, 7 hulls (the defector does not count).
    (
        id: "op.act2.story.kittering", kind: Story, act: Act2,
        name: "op.act2.story.kittering.name", briefing: "op.act2.story.kittering.briefing",
        unlock: All([Completed(["op.act2.story.ness"]), Any([Completed(["op.act2.story.amble"]), AlertAtLeast(region: "region.corran", value: 2)])]),
        node: Some("harbour.kittering"),
        objective: Escort(tag: "defector", exit: "exit"),
        tags: [Passengers(count: 4, allowed_losses: 1), MinSpeed(kn: 26.0), Range(min_km: 250.0)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoHullDamage, reward: Intel(1)), (kind: NoKills, reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.convoy.defector", marker: "berth", tag: "defector", stance: Neutral),
            (fleet: "fleet.act2.tg.gun", marker: "enemy", tag: "pursuit"),
            (fleet: "fleet.act2.patrol", marker: "enemy_2", tag: "patrol"),
        ],
        complications: [None, WeatherTurns(to: FogBank, at_s: 300), AirPatrol],
        approach_m: 12000.0,
        actions: [CarryPassengers],
    ),
    // 4. The Blackwater line: mine the channel the Sallow task group uses, so the forward base is cut off before
    // the strike. The Broker arrives. Needs the Amble run, then the Kittering codes or Supply under 40.
    // Commitment: heavy patrol 1,205 t (3) + strike task group 2,017 t (5) = 3,222 t, 8 hulls, plus the Broker.
    (
        id: "op.act2.story.blackwater", kind: Story, act: Act2,
        name: "op.act2.story.blackwater.name", briefing: "op.act2.story.blackwater.briefing",
        unlock: All([Completed(["op.act2.story.amble"]), Any([Completed(["op.act2.story.kittering"]), SupplyBelow(region: "region.corran", value: 40.0)])]),
        node: Some("sea.blackwater"),
        objective: LayMines(marker: "lane", count: 8),
        tags: [Requires(MineRail), Range(min_km: 250.0), RcsLimit(max_m2: 180.0)],
        ghosts: [(kind: NeverDetected, reward: Intel(2)), (kind: NoKills, reward: Intel(1)), (kind: NoHullDamage, reward: Intel(1))],
        force: [
            (fleet: "fleet.act2.patrol.heavy", marker: "lane", tag: "patrol"),
            (fleet: "fleet.act2.tg.strike", marker: "enemy", tag: "task_group"),
        ],
        complications: [AceArrives("ace.broker")],
        approach_m: 13000.0,
        actions: [LayMines],
        declared_hostile: ["class.bond", "class.ace_commission"],
        recommended_emcon: Some(Silent),
    ),

    // =========================================================================================================
    // Ace duels: the ace's flagship sails alone in its own group (tag "ace"); its consorts sail apart.
    // =========================================================================================================
    // Commitment: Indemnity 246 t (1) + strike task group 2,017 t (5) = 2,263 t, 6 hulls. The act's "defaults fail,
    // sliders pass" operation; see the header for its reference setup.
    (
        id: "op.act2.duel.underwriter", kind: AceDuel("ace.underwriter"), act: Act2,
        name: "op.act2.duel.underwriter.name", briefing: "op.act2.duel.underwriter.briefing",
        unlock: Completed(["op.act2.story.amble"]),
        objective: DestroyGroup(tag: "ace", fraction: 1.0),
        tags: [MinSpeed(kn: 30.0), Range(min_km: 300.0)],
        ghosts: [(kind: CaptureTheAce, reward: Intel(3)), (kind: NoHullDamage, reward: Intel(2))],
        force: [
            (fleet: "fleet.act2.ace.indemnity", marker: "enemy", tag: "ace", emcon: Some(Silent)),
            (fleet: "fleet.act2.tg.strike", marker: "enemy_2", tag: "task_group"),
        ],
        complications: [None, WeatherTurns(to: Haze, at_s: 600)],
        approach_m: 15000.0,
        declared_hostile: ["class.ace_indemnity"],
        reference_setup: Some("reference/act2/duel_underwriter.bp.ron"),
    ),
    // Commitment: Commission 923 t (1) + screen task group 1,767 t (5) = 2,690 t, 6 hulls.
    (
        id: "op.act2.duel.broker", kind: AceDuel("ace.broker"), act: Act2,
        name: "op.act2.duel.broker.name", briefing: "op.act2.duel.broker.briefing",
        unlock: Completed(["op.act2.story.blackwater"]),
        objective: DestroyGroup(tag: "ace", fraction: 1.0),
        tags: [Range(min_km: 300.0), RcsLimit(max_m2: 160.0)],
        ghosts: [(kind: CaptureTheAce, reward: Intel(3)), (kind: NeverDetected, reward: Intel(2))],
        force: [
            (fleet: "fleet.act2.ace.commission", marker: "enemy", tag: "ace"),
            (fleet: "fleet.act2.tg.screen", marker: "enemy_2", tag: "task_group"),
        ],
        complications: [None, WeatherTurns(to: Rain, at_s: 900), AirPatrol],
        approach_m: 16000.0,
        declared_hostile: ["class.ace_commission"],
    ),

    // =========================================================================================================
    // Capstone: Sallow. Open once the four story operations are done (the generator checks the act's list).
    // =========================================================================================================
    // Commitment: garrison 597 t (3) + heavy task group 2,350 t (5) + strike task group at 600 s 2,017 t (5)
    // = 4,964 t, 13 hulls, plus a four-aircraft raid at 300 s and the Broker if still at sea.
    (
        id: "op.act2.capstone", kind: Capstone, act: Act2,
        name: "op.act2.capstone.name", briefing: "op.act2.capstone.briefing",
        node: Some("base.sallow"),
        objective: DestroySite(marker: "depot"),
        tags: [Range(min_km: 350.0), DraftLimit(max_m: 3.5), MinSpeed(kn: 28.0)],
        ghosts: [(kind: NoHullDamage, reward: Intel(2)), (kind: UnderTime(seconds: 1800), reward: Intel(2)), (kind: NeverDetected, reward: Intel(3))],
        force: [
            (fleet: "fleet.act2.garrison", marker: "depot", tag: "garrison"),
            (fleet: "fleet.act2.tg.heavy", marker: "objective", tag: "task_group"),
            (fleet: "fleet.act2.tg.strike", marker: "enemy", tag: "reinforcements", arrives_s: 600),
            (fleet: "fleet.act2.air.strike", marker: "enemy_2", tag: "air", arrives_s: 300),
        ],
        complications: [AceArrives("ace.broker")],
        approach_m: 15000.0,
        declared_hostile: ["class.mortgage", "class.indenture"],
    ),
]
