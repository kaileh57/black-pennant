        declared_hostile: ["class.bond", "class.premium"],
    ),
    // Commitment: gun task group 1,805 t (5) + patrol 309 t (2) = 2,114 t, 7 hulls (the defector does not count).
    (
        id: "op.act2.defector_escort", kind: Template(DefectorEscort), act: Act2,
        name: "op.act2.defector_escort.name", briefing: "op.act2.defector_escort.briefing",
        objective: Escort(tag: "defector", exit: "exit"),
        tags: [Passengers(count: 4, allowed_losses: 1), MinSpeed(kn: 26.0), Range(min_km: 300.0)],
        ghosts: [(kind: NoHullDamage, reward: Intel(1)), (kind: NeverDetected, reward: Intel(2))],
        force: [
            (fleet: "fleet.act2.convoy.defector", marker: "objective", tag: "defector", stance: Neutral),
            (fleet: "fleet.act2.tg.gun", marker: "enemy", tag: "pursuit"),
            (fleet: "fleet.act2.patrol", marker: "enemy_2", tag: "patrol"),
        ],
        complications: [None, WeatherTurns(to: Rain, at_s: 600), AirPatrol, Reinforcements(fleet: "fleet.act2.patrol", at_s: 900)],
        approach_m: 12000.0,
        actions: [CarryPassengers],
