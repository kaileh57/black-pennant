// TuningTable: every number a gate fallback may rewrite, written out in full so fallback scripts edit a value in
// place and bump `version` (DESIGN.md L620, L189). Unit `data-tuning-rules` owns this file. The values are the
// spec's starting values, the same as the `Default` impls in crates/content/src/tuning.rs; a test holds the two
// equal until a fallback commits a change here.
(
    version: 1,
    // GM gauge thresholds as fractions of beam, and the capsize rule (L168-175, L537).
    stability: (gm_caution_low: 0.04, gm_caution_high: 0.15, capsize_heel_deg: 90.0, capsize_hold_s: 10.0),
    // Orifice flooding (L624-648). Cd stays 0.6; pacing moves only through flood_rate_scale (L632).
    flooding: (cd: 0.6, flood_rate_scale: 1.0, valve_m2: 0.1, magazine_flood_s: 10.0, level_bisection_steps: 16, flooded_fraction: 0.5, replication_hz: 2.0),
    // Fire (L660-669).
    fire: (
        ignite_near_fuel: 0.15, ignite_near_ammo: 0.25, ignite_radius_cells: 2, spread_per_s: 0.01, start_intensity: 100.0,
        burn_health_per_s: 0.01, cookoff_delay_s: 120.0, cookoff_r_min_cells: 4, cookoff_r_max_cells: 24,
        suppression_per_team: 2.0, autoflood_remaining_s: 60.0,
    ),
    // Crew capacity and damage-control jobs (L701-727, L822).
    crew: (
        berths_per_team: 4, min_teams: 1, max_teams: 6, jury_rig_s: 20.0, jury_rig_capacity: 0.5, patch_face_s: 10.0,
        repair_job_s: 30.0, repair_gain: 0.25, repair_cap: 0.75, veterancy_cap: 0.15,
    ),
    // Splitting and wrecks (L682-686).
    structure: (min_piece_cells: 64, max_wrecks: 16, wreck_ttl_s: 600.0, wreck_despawn_depth_m: 20.0),
    // Buoyancy blocks (L650, L658) and the hydro unit's hull drag coefficients. far_blocks_enabled is the
    // buoyancy gate's fallback (L658), applied 15 November 2026: the reference battle's buoyancy and waves span
    // measured over its 1.25 ms share (`black-pennant-server reference-battle`, budget buoyancy_waves).
    buoyancy: (
        block_cells: 4, far_blocks_enabled: true, far_block_cells: 8, far_distance_m: 2000.0, water_density: 1025.0,
        drag_form: 0.35, drag_skin: 0.003, drag_lateral: 1.1, drag_angular: 0.8,
    ),
    // Projectile caps by degradation rung and point-defence rounds (L557, L597).
    projectiles: (live_caps: (2000, 1500, 1000), pd_self_destruct_s: 4.0, pd_proximity_m: 1.5, broadphase_cell_m: 128.0),
    // Defence objects (L599-604, L524).
    decoys: (
        chaff_rcs_m2: 1000.0, chaff_bloom_s: 3.0, chaff_life_s: 60.0,
        flare_mw: 20.0, flare_life_s: 5.0,
        towed_distance_m: 200.0, towed_rcs_factor: 2.0, towed_noise: 4.0,
        smoke_radius_m: 60.0, smoke_height_m: 30.0, smoke_grow_s: 10.0, smoke_life_s: 120.0,
        resolution_cell_m: 300.0,
    ),
    // Wave set (L1116-1127, L1887).
    waves: (component_count: 12, min_wavelength_m: 8.0, max_wavelength_m: 400.0, max_steepness_sum: 0.85, swell_count: 2),
    // Network buffers and local control (L394).
    networks: (battery_s: 30.0, day_tank_s: 60.0, local_control_error_factor: 3.0),
    // Detection model (L410-456).
    sensors: (
        search_radar_hz: 5.0, sigma_ref_m2: 100.0, clutter: (0.0, 0.5, 2.0), clutter_full_below_m: 5.0, clutter_zero_above_m: 15.0,
        jammer_r_bt0_m: 10000.0, esm_range_factor: 2.0, visual_ref_range_m: 10000.0, night_visual_factor: 0.3, camera_range_factor: 2.0,
        passive_sonar_r_ref_m: 8000.0, active_sonar_r_ref_m: 4000.0, torpedo_noise: 1.0, layer_cross_factor: 0.3, shadow_zone_m: 5000.0,
        spatial_grid_cell_m: 5000.0, assumed_enemy_mast_m: 20.0,
    ),
    // Track filter (L458-468): sigma_a for surface or subsurface, aircraft, missiles, bearing-only. gate_sigma
    // is the association gate's duplicates fallback (L468: "if duplicates persist, it grows to 3.5 sigma"),
    // applied 20 November 2026 from the spec's 3.03: in the reference battle (tests/reference_battle.rs) a
    // Combine side held a fire-control Lock track and a search-radar and visual track on the player's hull,
    // both updated, for 15 to 33 s at 3.03 sigma, and 1 s at 3.5; the 60 s reference scene's truths holding a
    // duplicate over 10 s fell from 29 to 24 (`duplicate_probe`), not to zero. Track swaps were unchanged at
    // 11.9% and 11.5% of sampled updates, two thirds of them inside weapon salvos and a third surface tracks;
    // L468's swap clause (shrink to 2.5 sigma) points the other way and awaits the owner.
    tracks: (sigma_a: (0.3, 20.0, 50.0, 0.5), gate_sigma: 3.5, drop_surface_s: 120.0, drop_air_s: 20.0, last_known_s: 600.0, bearing_only_min_range_fraction: 0.1),
    // Guidance (L516-527).
    guidance: (gun_iteration_cap: 6, gun_converge_m: 0.25, pn_antiship: 3.0, pn_sam: 4.0, seeker_fov_half_deg: 30.0, midcourse_hz: 1.0),
    // Engagement doctrine and emission control defaults (L479-492, L505-512).
    doctrine: (
        effective_range_pk: 0.1, self_defence_range_m: 4000.0, pd_gun_cap_m: 2000.0, pd_missile_cap_m: 8000.0, missile_range_fraction: 0.8,
        inbound_cpa_m: 500.0, inbound_horizon_s: 60.0, decoy_trigger_m: 6000.0, burst_trigger_m: 20000.0, burst_rotations: 3,
        burst_repeat_s: 30.0, burst_repeat_engaged_s: 10.0, silent_pd_radar_m: 8000.0,
    ),
    // Complexity point coefficients (L973-976). They are fitted on the owner's Mac under the minimum-spec
    // throttle profile and checked on the hosted Windows runner; until that fit is committed they stay zero, so
    // the gauge reads 0 points and the PvP cap of 600 per vessel never refuses a design.
    complexity: (cuboid: 0.0, buoyancy_sample: 0.0, conduit_segment: 0.0, compartment: 0.0, graph_node_eval: 0.0, luau_interrupt: 0.0, caution_points: 400.0),
    // Special-operations actions (L786-797).
    special_ops: (
        board_range_m: 200.0, board_max_speed_kn: 5.0, board_s: 90.0,
        hold_max_speed_kn: 3.0, hold_range_m: 100.0, hold_s: 60.0,
        mine_spacing_m: 50.0, mine_course_tolerance_deg: 5.0, mine_min_speed_kn: 6.0,
        photo_hold_s: 20.0,
    ),
)
