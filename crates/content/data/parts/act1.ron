        id: "magazine.57mm", name: "part.magazine.57mm.name", description: "part.magazine.57mm.desc",
        category: Gun, tier: T2, phase: R010, size: (3, 2, 3), placement: Internal, mass_kg: 500.0, cost: 10,
        watertight: true, flammable: Ammunition, tags: [Magazine],
